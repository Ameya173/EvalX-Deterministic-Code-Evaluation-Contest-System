# Copy this file to .env and edit. Never commit .env.

# --- Infrastructure (defaults match docker-compose.dev.yml) ---
MONGO_URL=mongodb://127.0.0.1:27017/judgebox
REDIS_URL=redis://127.0.0.1:6379

# --- API ---
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Generate long random strings, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
# Set to true when serving over HTTPS (production)
COOKIE_SECURE=false

# --- Seed data ---
ADMIN_HANDLE=admin
ADMIN_EMAIL=admin@judgebox.local
ADMIN_PASSWORD=Admin@12345

# --- Worker / sandbox ---
SANDBOX_IMAGE=judgebox-sandbox
WORKER_CONCURRENCY=2
# Timing policy for verdicts: adaptive (C1), single, fixed3
TIMING_POLICY=adaptive
# Mutants per strength analysis and stress inputs per problem (C3)
STRENGTH_MAX_MUTANTS=30
STRENGTH_STRESS_INPUTS=40
